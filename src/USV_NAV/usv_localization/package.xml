<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>usv_localization</name>
  <version>0.1.0</version>
  <description>
    Broadcast map→odom from map.yaml ref_gnss + BW GI320 (GNGGA/INSPVAA),
    with reset on GNSS degrade/recover, map–GNSS mismatch, FC origin jump,
    and prolonged IMU-only coasting.
  </description>
  <maintainer email="zza@todo.todo">zza</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>yaml-cpp</depend>
  <depend>bw_gi320_driver</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>m_common</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
