<?xml version="1.0"?>
<!--
  主机 ↔ 船端 NX 的 CycloneDDS 网卡配置。

  背景：主机（笔记本）有两块网卡——eno1（192.168.2.100，连船网）和 wlo1（WiFi）。
  若不加限制，CycloneDDS 会同时在两块网卡上做参与者发现，WiFi 侧组播干扰会导致
  主机“时好时坏”地发现不到船端 MAVROS 话题（node/topic 列表忽多忽少）。

  用法（在主机每个跑 ROS 的终端里，或在 ~/.bashrc 中）：
    export CYCLONEDDS_URI=file:///home/ght/USV_NAV/config/cyclonedds_boat.xml

  船端 NX 只需单网卡，无需此文件；两端统一 RMW_IMPLEMENTATION=rmw_cyclonedds_cpp。
-->
<CycloneDDS xmlns="https://cyclonedds.io/schemas/cyclonedds/1.0">
  <Domain>
    <General>
      <!-- 只使用连船的有线网卡，避免 WiFi 干扰发现 -->
      <Interfaces>
        <NetworkInterface name="eno1"/>
      </Interfaces>
      <AllowMulticast>true</AllowMulticast>
      <EnableMulticastLoopback>true</EnableMulticastLoopback>
    </General>
    <Discovery>
      <!-- 额外向船端 NX 单播 SPDP，组播不通时也能稳定发现（船端地址 192.168.2.101） -->
      <Peers>
        <Peer address="192.168.2.101"/>
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
