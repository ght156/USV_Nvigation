# 上层 → 导航：下发航线（Service 接口）
#
# 实现：m_common/srv/SendWaypoints.srv
# Service：/mission_bridge/send_waypoints
# 航点：m_common/msg/MissionWaypoint（latitude, longitude, yaw）
#
# 1 点=单点，≥2=多点；调用即开始；RUNNING/PAUSED 自动抢占
# WAITING_SYSTEM / EMERGENCY → success=false

m_common/MissionWaypoint[] waypoints
string mission_id
string command_id
---
bool success
string message
